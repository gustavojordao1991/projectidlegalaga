# ==============================================================================
# GALAGA IDLE - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copie este arquivo para .env em ambiente local de desenvolvimento:
# cp .env.example .env
# NUNCA comite arquivos .env contendo credenciais reais no repositório.

# --- SERVER CONFIGURATION ---
NODE_ENV=development
PORT=3333
HOST=0.0.0.0
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# --- DATABASE CONFIGURATION (PostgreSQL) ---
DATABASE_URL=postgresql://galaga_user:galaga_password@localhost:5432/galaga_idle_db?schema=public
DB_MAX_CONNECTIONS=20
DB_TIMEOUT_MS=5000

# --- CACHE & RATE LIMITING (Redis) ---
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=galaga:idle:
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# --- SECURITY & AUTHENTICATION (JWT) ---
# Em produção, gere uma chave de alta entropia (ex: openssl rand -base64 64)
JWT_SECRET=super_secret_development_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=super_secret_refresh_key_change_in_production_min_32_chars
REFRESH_TOKEN_EXPIRES_IN=7d

# --- GAME BALANCING & IDLE ENGINE ---
MAX_OFFLINE_IDLE_HOURS=24
IDLE_TICK_RATE_MS=1000
ANTI_CHEAT_MAX_DRIFT_SECONDS=5

# --- LOGGING & AUDIT ---
LOG_LEVEL=debug
ENABLE_SECURITY_AUDIT_LOGS=true
